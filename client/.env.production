NODE_ENV=production
VITE_APP_MAPBOX_API_KEY=
# Do not set VITE_APP_FACETS_CONFIG_FILE here: Vite bakes it into the JS bundle at build time,
# bypassing the config file deployments mount at dist/config/config.yaml (see docker/docker-compose_dev.yaml).
# Unset, the app falls back to config/config.yaml, which is the mount target.
#VITE_APP_FACETS_CONFIG_FILE=config/config_qlever_and_or.yaml
#NODE_OPTIONS=--openssl-legacy-provider
VITE_APP_TITLE=GeoCodes
