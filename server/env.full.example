S3ADDRESS="oss.geocodes-aws.earthcube.org"
S3KEY=
S3SECRET=

## optional these are the defaults
useSSL=true
S3PORT=
BUCKET='test'
BUCKETPATH='summoned'
PATHTEMPLATE='/{{bucketpath}}/{{reponame}}/{{sha}}.jsonld'

TOOLTEMPLATE ='{{bucketpath}}/{{reponame}}/{{ref}}.jsonld'
TOOLBUCKET='ecrr'
TOOLPATH='summoned'
TOOLREPO='ecrr_submitted'
URIVERSION='v2'

## MCP facet search endpoint (POST /mcp)
# SPARQL endpoint queried by the MCP tools (QLever)
TRIPLESTORE_URL='https://qlever.geocodes-aws-dev.earthcube.org/graphspace/facetsearch'
# 'qlever' (default) or 'blazegraph'
QUERY_ENGINE='qlever'
# SPARQL query timeout, e.g. '20s'
SPARQL_TIMEOUT='20s'
# default and maximum page size for search_datasets
MCP_LIMIT_DEFAULT=10
MCP_LIMIT_MAX=200
