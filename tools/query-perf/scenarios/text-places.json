{
  "name": "Text facet: Place names filter",
  "description": "Test place name facet filtering. places are funky. IEDA uses comma delimited names. needs an exploration",
  "tests": [
    {
      "name": "places: discovery only",
      "search": "ocean",
      "facets": [
        { "type": "text", "field": "placenames", "active": false }
      ]
    },
    {
      "name": "places: single place (10 items, 60 in triplestore)",
      "search": "ocean",
      "facets": [
        { "type": "text", "field": "placenames", "active": true, "values": ["Ross Sea"] }
      ]
    },
    {
      "name": "places: single place Atlantic Ocean (one item)",
      "search": "ocean",
      "facets": [
        { "type": "text", "field": "placenames", "active": true, "values": ["Atlantic Ocean"] }
      ]
    },
    {
      "name": "places: multiple places (~7)",
      "search": "ocean",
      "facets": [
        { "type": "text", "field": "placenames", "active": true, "values": ["Atlantic Ocean", "Pacific Ocean", "Arctic Ocean"] }
      ]
    }
  ]
}
